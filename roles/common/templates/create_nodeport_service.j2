---
apiVersion: v1
kind: Service
metadata:
  name: "{{ name}}"
  namespace: "{{ namespace }}"
spec:
  type: NodePort
  ports:
    - name: http
      protocol: TCP
      port: "{{ port }}"
      targetPort: "{{ targetPort }}"
      nodePort: "{{ nodeports | selectattr('application', 'match', 'homepage',) | map(attribute='port') | first }}"
  selector:
    app: "{{ app }}"